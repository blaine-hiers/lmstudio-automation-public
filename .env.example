# Names only. Everything here has a working default in lmsa/config.py, so a
# local run needs no .env at all. Secrets (Gmail app password, third-party API
# keys) live in Windows Credential Manager (`python -m lmsa.secrets set
# <name>`) or this gitignored local .env, never in the repo.

LMSTUDIO_BASE_URL=
LMSTUDIO_API_KEY=
LMSA_CHAT_MODEL=
LMSA_EMBED_MODEL=
LMSA_VISION_MODEL=
LMSA_OUTPUT_DIR=
LMSA_TIMEOUT=
LMSA_SLACK_WEBHOOK=
LMSA_DB=
LMSA_FRONT_PAGE_CONFIG=
LMSA_IMAP_HOST=
LMSA_IMAP_PORT=
LMSA_IMAP_USER=
LMSA_IMAP_PASSWORD=
LMSA_SMTP_HOST=
LMSA_SMTP_PORT=
LMSA_LOG_RETENTION_DAYS=
LMSA_DOC_INBOX_DIR=
LMSA_SEARXNG_URL=
LMSA_SEARXNG_START=
LMSA_SEARXNG_START_TIMEOUT=
LMSA_FIRMS_MAP_KEY=
LMSA_GITHUB_OWNER=

LMSA_RECORDINGS_DIR=
LMSA_WHISPER_MODEL=
LMSA_WHISPER_DEVICE=

# Set by Windows itself (not something you configure); tasks.bookmarks reads
# it to find the default Chrome/Edge "Bookmarks" profile paths. Override the
# paths directly in config/bookmarks.toml instead of overriding this.
LOCALAPPDATA=

LMSA_PHOTOS_DIR=
